---
title: "Projects"
import Layout from '../layouts/Layout.astro'
import projectsData from '../data/projects-data.js'
---

<Layout>
  <main class="flex-grow p-10">
    <div class="mx-auto projects-grid">
      {projectsData.map(project => (
        <a href={`/ishratalidesign/projects/${project.slug}`} class="project-link">
          <div class="relative h-80 overflow-hidden d-flex align-items-center justify-content-center">
            <img src={project.images[0].src} alt={project.title} class="img-fluid w-100 h-100 object-fit-cover transition-transform duration-300 hover:scale-110" style="aspect-ratio: 1 / 1; min-width: 0; min-height: 0;" />
            <div class="overlay">
              <h3 class="title" set:html={project.title.replace(/ /g, '<br>')}></h3>
              <p class="footer">{project.projectDetails[0]?.value}</p>
            </div>
          </div>
        </a>
      ))}

    </div>
  </main>
</Layout>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    max-width: 900px;
  }
  .object-fit-cover {
    object-fit: cover !important;
    width: 100% !important;
    height: 100% !important;
    aspect-ratio: 1 / 1 !important;
    min-width: 0 !important;
    min-height: 0 !important;
    display: block;
  }
  .project-link .overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #4F1C51;
    color: #FFFBF8; 
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition: opacity 0.3s ease;
    text-align: center;
    padding: 1rem;
    gap: 2.188rem;

    font-family: 'Fraunces', serif;
    font-weight: 700;
  }

  .project-link:hover .overlay {
    opacity: 0.7;
  }

  .project-link .title {
    font-size: 1.5rem;
    text-transform: uppercase;
    word-break: break-word;
    margin-top: auto;
  }

  .project-link .footer {
    font-size: 1rem;
    margin-bottom: auto;
  }

  .project-link {
    transition: transform 0.3s ease;
  }

  .project-link:hover {
    transform: translateY(-10px);
  }
</style>
