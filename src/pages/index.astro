---
title: "Home";
description: "Welcome to my portfolio! I'm a graphic designer passionate about bold colors and meaningful visuals.";
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import polaroidpic from "../assets/polaroidpic.png";
import welcome from "../assets/welcome.png";
import portfolio from "../assets/portfolio.png";

---

<Layout includeNavBottomBorder={false}>

  <div
    class="container-fluid px-0 d-flex align-items-center justify-content-center cover-ctn"
  >
    <div class="row">
      <div class="col-12">
        <Image src={welcome} alt="Welcome Image" class="img-fluid mx-auto" />
        <Image src={portfolio} alt="Portfolio Image" class="img-fluid mx-auto portfolio-img" />
      </div>
    </div>
  </div>

  <div class="container mt-4 body-content">
    <div class="row align-items-center t-sp">
      <!-- Left Column -->
      <div class="col-md-8 text-start order-md-1 order-2">
        <p class="fraunces-header">
          Hi, I’m Ishrat—a <span class="sp-t">freelance graphic designer </span> & <span class="sp-t">artist</span> based in Detroit, Michigan.
        </p>
        <p class="fraunces-body">
          I thrive on bold colors, expressive illustrations, and creating meaningful visuals that amplify underrepresented voices. Whether it’s storytelling, representation, or making a statement, I love pushing boundaries and making a lasting impact with my creativity. Welcome to my world of design!
        </p>
        <a href="/ishratalidesign/about" class="btn btn-learnmore mt-4"
          >Learn more</a
        >
      </div>
      <!-- Right Column -->
      <div class="col-md-4 text-center order-md-2 order-1">
        <Image
          src={polaroidpic}
          alt="Polaroid Picture"
          class="img-fluid mx-auto polaroid-pic"
        />
      </div>
    </div>
  </div>
</Layout>

<style>
  .portfolio-img {
    margin-top: -36px;
  }
  .body-content {
    margin-bottom: 15vh;
  }
  .polaroid-pic {
    height: 40vh;
    width: auto;
  }
  .fraunces-header {
    font-family: "Fraunces", serif;
    font-weight: 700;
    color: #3e2c77; /* Match your theme */
    font-size: 3rem;
  }
  .fraunces-body {
    color: #3e2c77; /* Match your theme */
    font-family: "Fraunces", serif;
    font-weight: 400;
    font-size: 28px;
    line-height: 1.5;
    letter-spacing: 0;
    font-variation-settings:
    "SOFT" 0,
    "WONK" 0;
  }
  .sp-t {
    font-family: "Fraunces", serif;
    color: #a55b4b;
    font-weight: bold;
    font-style: italic;
    font-size: 3rem;
  }
  .btn-learnmore {
    background-color: #4F1C51;
    color: #FFFBF8;
    padding: 10px 20px;
    font-size: 1rem;
  }
  .btn-learnmore:hover {
    background-color: #A55B4B;
    color: #FFFBF8;
  }
  body {
    background: #fffbf8;
  }
  .cover-color {
    color: white;
  }
  .cover-row {
    width: 100%;
  }
  .bg-3e2c77 {
    background: #231354;
  }
  .cover-ctn {
    height: 60vh;
  }

  .fade-in {
    opacity: 0;
    animation: fadeIn 2.9s ease-in-out forwards;
  }

  @keyframes fadeIn {
    0% { opacity: 0; }
    100% { opacity: 1; }
  }
</style>