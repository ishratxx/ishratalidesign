---
// Import the template
import ProjectTemplate from "../../components/ProjectTemplate.astro";


const projectDetails = [
  { label: "Project Type", value: "Brand Identity & Package Design" },
  { label: "Role", value: "Designer" },
  { label: "Tools Used", value: "Adobe InDesign | Illustrator | PhotoShop" },
  { label: "Year", value: "2025" },
];

const rightColumn = [
  "Jahira is a conceptual skincare line rooted in confidence, self-expression, and bold beauty. This line believes that every individual deserves to feel confident in their own skin. Jahira is crafted with a passion for enhancing your radiance, using scientifically proven ingredients and innovative formulations to deliver promising results. It contains products that can target any skin concern such as aging, hyperpigmentation and psoriasis with high quality ingredients such as Niacinamide and Centella Asiatica Extract. ",
  "Designed to stand out on any shelf, Jahira’s packaging features vivid, saturated colors that reflect the energy and individuality of its users. More than just skincare, Jahira represents a fearless approach to self-care—where skin health meets artful design. Each product is thoughtfully formulated and visually striking, merging effective ingredients with a bold aesthetic that invites users to embrace their routine with intention and personality.",
];

const images = [
  { col: 12, src: "/ishratalidesign/images/jahira/JahiraMockup1.png", alt: "Mockup 1", width: "100vw", height: "100%" },
  { col: 12, src: "/ishratalidesign/images/jahira/JahiraMockup2.png", alt: "Mockup 2", width: "100vw", height: "100%" },
  { col: 12, src: "/ishratalidesign/images/jahira/JahiraCards.png", alt: "Mockup 4", width: "100vw", height: "100%" },
  { col: 12, src: "/ishratalidesign/images/jahira/JahiraBags.png", alt: "Mockup 3", width: "100vw", height: "100%" },
  { col: 12, src: "/ishratalidesign/images/jahira/BrandGuidelines.png", alt: "winter months", width: "100vw", height: "100%" },
  { col: 12, src: "/ishratalidesign/images/jahira/JahiraScreenMockup.png", alt: "winter months", width: "100vw", height: "100%" },
  { col: 12, src: "/ishratalidesign/images/jahira/Jahira.gif", alt: "winter months", width: "100vw", height: "100%" }
];
---

<ProjectTemplate
  title="Jahira"
  description="Skincare"
  projectDetails={projectDetails}
  rightColumn={rightColumn}
  images={images}
/>
