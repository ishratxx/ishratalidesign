---
title: "Contact"
import Layout from '../layouts/Layout.astro'
description: "Contact Us"
---


<Layout includeNavBottomBorder={false}>
  <div class="container d-flex flex-column align-items-center justify-content-center" style="min-height: 64vh;">
    <h1 class="display-5 text-center mt-5 mb-2" style="color: #3e2c77; font-family: 'Fraunces', serif; font-weight: 700;">Want to chat?</h1>
    <h2 class="text-center mb-4" style="color: #3e2c77; font-family: 'Fraunces', serif; font-style: italic; font-weight: 700;">Send me a <span style="font-style: italic;">message!</span></h2>
    <form class="w-100" style="max-width: 500px;" action="https://formspree.io/f/yourFormID" method="POST">
      <div class="row mb-3">
        <div class="col">
          <label for="firstName" class="form-label">First Name</label>
          <input type="text" class="form-control" id="firstName" name="firstName" autocomplete="given-name">
        </div>
        <div class="col">
          <label for="lastName" class="form-label">Last Name</label>
          <input type="text" class="form-control" id="lastName" name="lastName" autocomplete="family-name">
        </div>
      </div>
      <div class="mb-3">
        <label for="email" class="form-label">Email <span style="color: #a55b4b;">(required)</span></label>
        <input type="email" class="form-control" id="email" name="email" required autocomplete="email">
      </div>
      <div class="mb-3">
        <label for="message" class="form-label">Your Message <span style="color: #a55b4b;">(required)</span></label>
        <textarea class="form-control" id="message" name="message" rows="5" required placeholder="Enter your question or message"></textarea>
      </div>
      <div class="d-flex justify-content-center">
        <button type="submit" class="btn btn-submit px-5 py-2 w-100">SUBMIT</button>
      </div>
    </form>
  </div>
</Layout>

<style>
  body {
    background: #fffbf8;
  }
  .btn-submit {
    background-color: #3e2c77;
    color: white;
    font-family: 'Fraunces', serif;
    font-size: 1rem;
    letter-spacing: 0.1em;
    border-radius: 4px;
    transition: background 0.2s, color 0.2s;
  }
  .btn-submit:hover {
    background-color: #ece8fc;
    color: #42328f;
  }
  .form-label {
    font-family: 'Fraunces', serif;
    color: #3e2c77;
    font-weight: 600;
  }
  input:focus, textarea:focus {
    border-color: #a55b4b;
    box-shadow: 0 0 0 0.2rem rgba(165,91,75,.15);
  }
</style>
