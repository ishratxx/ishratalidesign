---
import logo from '../assets/ialogo.png';
import { Image } from 'astro:assets';

---

<header class="py-3">
  <div class="container d-flex justify-content-between align-items-center  p-xs-2 flex-wrap">
    <div class="text-primary">
      <a href="/ishratalidesign/" class="text-decoration-none d-flex align-items-start">
        <Image src={logo} alt="Logo" class="img-fluid logo" />
      </a>
    </div>
    <nav class="d-flex gap-3 flex-wrap nav-links">
      <a href="/ishratalidesign/projects" class="h-color text-decoration-none">projects</a>
      <a href="/ishratalidesign/sidenotes" class="h-color text-decoration-none">side notes</a>
      <a href="/ishratalidesign/about" class="h-color text-decoration-none">about</a>
      <a href="/ishratalidesign/contact" class="h-color text-decoration-none">contact</a>
    </nav>
  </div>
</header>

<style>
  .logo {
    height: 4.375rem;
    width: auto;
  }
  header {
    background-color: #fffbf8;
  }
  .h-color {
    color: #3E2C77
  }
  a:hover {
    color: #A55B4B;
  }
  @media (max-width: 768px) {
    .nav-links {
      flex-direction: row !important;
      align-items: center !important;
      gap: 0.5rem !important;
      width: auto;
      margin-top: 0;
      flex-wrap: nowrap;
      justify-content: flex-end;
    }
    .container.d-flex {
      flex-direction: row !important;
      align-items: center !important;
      flex-wrap: nowrap;
    }
    .logo {
      height: 3rem;
      margin-bottom: 0;
    }
  }
</style>